@startuml DeviceStateManagerComponents
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

System_Boundary(home_management_boundary, "Управление домом пользователя") {
    ContainerDb(home_management_db, "Home DB", "PostgreSQL", "Хранит метаданные дома пользователя")

    Component(home_in, "Home in controller", "Spring REST Controller", "Принимает HTTP-запросы от API Gateway")
    Component(home_service, "Home Service", "Spring Service", "Логика управления домом пользователя")
    Component(home_repository, "Home Repository", "Spring Data JPA", "Работа с PostgreSQL")
    Component(home_out, "Home out controller", "Component", "Коннекторы к внешним системам")
    Component(kafka_producer, "Kafka Producer", "Spring Kafka", "Отправка событий")
}

ContainerQueue(kafka, "Event Bus", "Apache Kafka", "Взаимодействие между микросервисами")
Container(api_gateway, "API Gateway", "Любой, с чем работала команда разработки", "Единая точка входа")

Rel(api_gateway, home_in, "POST/PUT/GET/DELETE", "HTTP/REST/JSON")

Rel(home_in, home_service, "Логика управление домом пользователя", "Java")
Rel(home_service, home_repository, "Сохранение/чтение метаданных", "JPA/Hibernate")
Rel(home_repository, home_management_db, "INSERT/UPDATE/DELETE операции", "JDBC")
Rel(home_service, home_out, "Вызов вн. системы", "Java")
Rel(home_out, kafka_producer, "Отправка события", "Java")
Rel(kafka_producer, kafka, "Отправить событие", "Kafka Protocol")

@enduml