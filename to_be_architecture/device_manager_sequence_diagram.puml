@startuml DeviceStateManagerSequence

actor User as user
participant "API Gateway" as gateway
participant "State Controller" as controller
participant "State out connectors" as connectors
participant "State Service" as service
participant "State Repository" as repository
participant "Device State DB" as db
participant "Kafka Consumer" as consumer
participant "Hub Controller" as hub

user -> gateway : PUT /devices/{id}/state
gateway -> controller : HTTP Request (JSON)
controller -> service : ResponseEntity updateDeviceState(deviceId, newState)

service -> repository : void save(updatedState)
repository -> db : UPDATE
db --> repository : savedState
repository --> service : savedState
service -> connectors : void updateDeviceState(deviceId, savedState)

connectors -> gateway : HTTP Request (JSON)
gateway -> hub : HTTP Request (JSON)
hub --> gateway : HTTP Response OK
gateway --> connectors : HTTP Response OK
connectors --> service : void updateDeviceState(deviceId, savedState)

service --> controller : ResponseEntity
controller --> gateway : HTTP Response
gateway --> user : 200 OK

kafka -> consumer : TelemetryEvent
consumer -> service : handleTelemetryEvent(event)
service -> repository : findById(deviceId)
repository -> db : SELECT
db --> repository : DeviceState
repository --> service : DeviceState

service -> service : applyOrRejectNewState()
service -> repository : save(updatedState)
repository -> db : UPDATE
db --> repository : savedState
repository --> service : savedState

service -> connectors : void updateDeviceState(deviceId, savedState)
connectors -> gateway : HTTP Request (JSON)
gateway -> hub : HTTP Request (JSON)
hub --> gateway : HTTP Response OK
gateway --> connectors : HTTP Response OK
connectors --> service : void updateDeviceState(deviceId, savedState)

@enduml